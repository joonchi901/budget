{
  "name": "our-budget",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite",
    "dev:worker": "wrangler dev --ip 127.0.0.1 --port 8787",
    "db:init": "wrangler d1 migrations apply budget-dev --local",
    "db:seed": "node scripts/seed.mjs",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \".storybook/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"*.{json,md}\"",
    "storybook": "storybook dev --host 127.0.0.1 --port 6006 --no-open --disable-telemetry",
    "build:storybook": "npm run check:ui-spec && storybook build --disable-telemetry",
    "test:storybook": "node scripts/test-storybook.mjs",
    "check:ui-spec": "node scripts/check-ui-spec.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:ui": "npm run typecheck && npm run build:storybook && npm run test:storybook"
  },
  "dependencies": {
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260916.1",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@storybook/test-runner": "0.24.5",
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-playwright": "2.2.2",
    "prettier": "3.9.6",
    "storybook": "10.6.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "2.0.0",
    "wrangler": "4.132.0"
  },
  "overrides": {
    "@storybook/test-runner": {
      "uuid": "11.1.1"
    }
  }
}
