// Local development only: the API Worker and a local D1. Production config comes with Google login.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-budget",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-16",
  // Prunes the sync log daily at 03:17 KST (docs/sync-plan.md §3.8).
  "triggers": { "crons": ["17 18 * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-dev",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "migrations",
    },
  ],
  // A room per ledger that signals its members' sockets (docs/sync-plan.md §5). The free plan
  // takes SQLite-backed classes only; the room stores nothing.
  "durable_objects": { "bindings": [{ "name": "ROOMS", "class_name": "Room" }] },
  "migrations": [{ "tag": "room-v1", "new_sqlite_classes": ["Room"] }],
}
