{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "our-budget",
  "main": "src/server/index.ts",
  "compatibility_date": "2026-09-16",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "budget-local",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "durable_objects": { "bindings": [{ "name": "COLLABORATION", "class_name": "HouseholdRoom" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["HouseholdRoom"] }],
  "env": {
    "production": {
      "name": "our-budget-production",
      "account_id": "ea8edaa239f697f86347131b03db228b",
      "workers_dev": true,
      "preview_urls": false,
      "vars": { "DEMO_MODE": "false" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "budget-production",
          "database_id": "700713f0-f352-463f-aea1-a05336091a66",
          "migrations_dir": "migrations",
        },
      ],
      "durable_objects": {
        "bindings": [{ "name": "COLLABORATION", "class_name": "HouseholdRoom" }],
      },
    },
  },
}
